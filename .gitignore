# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio / IntelliJ
*.iml
.idea/
.DS_Store
captures/
.externalNativeBuild/
.cxx/

# Keystore files
*.jks
*.keystore

# Compose / Kotlin
.kotlin/

# Local verification output
verification/*.png

# Disposable local browser/tool output
.cache/

# LocalHub
deliverables/
.kotlin/

# EXCEPTION: the shared DEBUG signing key is committed on purpose.
#
# Without it every machine and CI runner generates a different debug keystore, so
# each build gets a different signature and Android refuses to install one build
# over another. This file is a *debug* key only (alias androiddebugkey, password
# android) - it is not a release key and must never be used to sign a release APK.
!localhub-debug.keystore
